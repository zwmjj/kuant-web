# Copy to .env.local and fill in real values. .env.local is gitignored.

# The only required variable: URL of your kuant-api FastAPI backend.
# For local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# For production deployment (Vercel / Cloudflare / etc):
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Optional: explicit app URL override (Next.js will derive this otherwise)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
